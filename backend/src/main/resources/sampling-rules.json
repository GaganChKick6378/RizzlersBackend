{
  "version": 2,
  "rules": [
    {
      "description": "Trace API calls",
      "host": "*",
      "http_method": "*",
      "url_path": "/api/*",
      "fixed_target": 1,
      "rate": 1.0
    },
    {
      "description": "Trace GraphQL queries and mutations",
      "host": "*",
      "http_method": "POST",
      "url_path": "/graphql",
      "fixed_target": 1,
      "rate": 1.0
    },
    {
      "description": "Health checks - low sampling",
      "host": "*",
      "http_method": "*",
      "url_path": "/actuator/health*",
      "fixed_target": 0,
      "rate": 0.05
    }
  ],
  "default": {
    "fixed_target": 1,
    "rate": 0.1
  }
} 